{
  "version": 2,
  "builds": [
    {
      "src": "server/start.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/start.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
